# SolidData MCP POC — copy to .env and fill in values.
# Required: SolidData management key and Gemini API key for the crew LLM.

SOLIDDATA_MANAGEMENT_KEY=your-soliddata-management-key-here
GEMINI_API_KEY=your-gemini-api-key-here
MODEL=gemini/gemini-2.0-flash

# Required: Semantic layer ID for Solid text2sql (UUID from the Solid platform URL)
SEMANTIC_LAYER_ID=

# For dev: use backend.dev.soliddata.io and mcp.dev.soliddata.io for AUTH_ENDPOINT and MCP_SERVER_URL
AUTH_ENDPOINT=https://backend.production.soliddata.io/api/v1/auth/exchange_user_access_key
MCP_SERVER_URL=https://mcp.production.soliddata.io/mcp

# Snowflake Credentials:
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- Azure REST bridge E2E only (scripts/e2e_openapi_test.py; NOT used by CrewAI / solid_mcp_tool) ---
# Base URL and host key default from openapi.yaml when unset; override here if needed.
# BRIDGE_BASE_URL=
# BRIDGE_FUNCTION_KEY=
# BRIDGE_TOOL=text2sql
# SEMANTIC_MODEL_ID=
# ASSET_NAME=
# ASSET_TYPE=
