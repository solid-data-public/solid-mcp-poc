# SolidData MCP POC — copy to .env and fill in values.
# Required: SolidData management key and Gemini API key for the crew LLM.

SOLIDDATA_MANAGEMENT_KEY=your-soliddata-management-key-here
GEMINI_API_KEY=your-gemini-api-key-here
MODEL=gemini/gemini-2.0-flash-lite

# Required: Semantic layer ID for Solid text2sql (UUID from the Solid platform URL)
SEMANTIC_LAYER_ID=

# Optional: for solid_semantic_model_qa (UUID of the semantic model)
# SEMANTIC_MODEL_ID=

# Optional: for solid_specific_asset_information (default table or dashboard name)
# ASSET_NAME=
# ASSET_TYPE=

# Optional: override MCP server URL (default is production)
MCP_SERVER_URL=https://mcp.production.soliddata.io/mcp

# Snowflake Credentials:
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
